{
    "name": "@diia-inhouse/eslint-plugin",
    "version": "1.9.6",
    "description": "common eslint plugin",
    "main": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "scripts": {
        "build": "tsc",
        "prebuild": "rimraf dist",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "start": "npm run build && node dist/index.js",
        "lint": "eslint \"**/*{.ts,.mts}\" && prettier --check .",
        "lint-fix": "eslint \"**/*{.ts,.mts}\" --fix && prettier --write .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "find-circulars": "madge --circular --extensions ts ./"
    },
    "files": [
        "dist",
        "src"
    ],
    "keywords": [],
    "author": "Diia",
    "devDependencies": {
        "@commitlint/cli": "20.1.0",
        "@diia-inhouse/configs": "6.1.1",
        "@typescript-eslint/rule-tester": "8.46.2",
        "@typescript-eslint/typescript-estree": "8.46.2",
        "@vitest/coverage-v8": "4.0.1",
        "@vitest/eslint-plugin": "1.3.23",
        "eslint": "9.38.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-prettier": "5.5.4",
        "jsonc-eslint-parser": "2.4.1",
        "lockfile-lint": "4.14.1",
        "madge": "8.0.0",
        "prettier": "3.6.2",
        "rimraf": "6.0.1",
        "semantic-release": "24.2.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.2",
        "vitest": "4.0.1"
    },
    "dependencies": {
        "@typescript-eslint/utils": "8.46.2",
        "ts-patch": "3.3.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package",
        "branches": [
            "main"
        ]
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    },
    "repository": "https://github.com/diia-open-source/be-eslint-plugin",
    "license": "SEE LICENSE IN LICENSE.md"
}
